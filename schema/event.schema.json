{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://legacy-football/schema/event.schema.json",
  "title": "Anlati olayi",
  "description": "src/loading/parse.ts'ten turetilmistir. Ayristirici KESIN Turkce hata mesaji verir; bu sema editorde otomatik tamamlama ve yazim yanlisi yakalamak icindir. Ikisi arasindaki tutarlilik tests/Schema.test.ts ile baglanmistir.",
  "type": "object",
  "required": [
    "id",
    "family",
    "category",
    "tier",
    "cooldown"
  ],
  "anyOf": [
    {
      "required": [
        "nodes",
        "rootNode"
      ]
    },
    {
      "required": [
        "variants"
      ]
    }
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^_": {
      "description": "Alt cizgi ile baslayan alanlar yazar notudur; ayristirici gormez."
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^evt_[a-z0-9_]+$",
      "description": "Benzersiz olay kimligi."
    },
    "family": {
      "type": "string",
      "pattern": "^fam_[a-z0-9_]+$",
      "description": "Aile cooldown'u bu alana bakar: ayni aileden olaylar ust uste gelmez."
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z_]+$",
      "description": "content/events/ altindaki klasor adiyla AYNI olmali."
    },
    "tier": {
      "enum": [
        "epic",
        "major",
        "minor",
        "beat"
      ],
      "description": "`filler` YOKTUR: her olay >=3 secim ve >=1 kalici sonuc tasir."
    },
    "authored": {
      "enum": [
        "hand",
        "generated"
      ],
      "default": "generated",
      "description": "Icerigin kokeni: 'hand' (elle yazilmis ozgun sahne) ya da 'generated' (model uretimi)."
    },
    "weight": {
      "type": "number",
      "default": 10
    },
    "cooldown": {
      "$ref": "#/definitions/cooldown"
    },
    "eras": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/era"
      }
    },
    "stature": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/stature"
      }
    },
    "clubTiers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/clubTier"
      }
    },
    "lifeStates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/lifeState"
      }
    },
    "mediaEras": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/mediaEra"
      }
    },
    "archetypes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/archetype"
      }
    },
    "personaAffinity": {
      "$ref": "#/definitions/persona"
    },
    "trigger": {
      "$ref": "#/definitions/condition"
    },
    "momentType": {
      "type": "string"
    },
    "story": {
      "$ref": "#/definitions/storyMeta"
    },
    "repeatPolicy": {
      "$ref": "#/definitions/repeatPolicy"
    },
    "once": {
      "type": "boolean"
    },
    "scheduledOnly": {
      "type": "boolean"
    },
    "rootNode": {
      "type": "string"
    },
    "nodes": {
      "$ref": "#/definitions/nodes"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "rootNode",
          "nodes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "rootNode": {
            "type": "string"
          },
          "nodes": {
            "$ref": "#/definitions/nodes"
          },
          "archetypes": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/archetype"
            }
          }
        }
      }
    },
    "lint": {
      "type": "object",
      "description": "Validator muafiyeti. GEREKCESIZ olamaz.",
      "required": [
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "ignore": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "definitions": {
    "era": {
      "enum": [
        "rookie",
        "rise",
        "prime",
        "veteran",
        "twilight"
      ]
    },
    "stature": {
      "enum": [
        "nobody",
        "local_talent",
        "starter",
        "star",
        "superstar",
        "icon",
        "legend"
      ]
    },
    "clubTier": {
      "enum": [
        "amateur",
        "lower",
        "mid",
        "contender",
        "elite"
      ]
    },
    "lifeState": {
      "enum": [
        "playing",
        "injured",
        "suspended",
        "incarcerated",
        "loaned",
        "transfer_listed",
        "national_duty",
        "rehab_clinic",
        "retired"
      ]
    },
    "mediaEra": {
      "enum": [
        "press",
        "twitter",
        "instagram",
        "tiktok",
        "deepfake"
      ]
    },
    "archetype": {
      "enum": [
        "street",
        "academy",
        "bloodline",
        "immigrant",
        "latebloom",
        "influencer"
      ]
    },
    "cooldown": {
      "type": "object",
      "description": "Iki seviyeli. Tek sayi YAZILAMAZ; aile cooldown'u 'ust uste 100 gece kulubu' hatasini onler.",
      "required": [
        "self",
        "family"
      ],
      "additionalProperties": false,
      "properties": {
        "self": {
          "type": "number",
          "minimum": 0
        },
        "family": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "persona": {
      "type": "object",
      "description": "Kimlik eksenleri secimlerle BIRIKIR; icerik bunlari dogrudan set edemez.",
      "additionalProperties": false,
      "properties": {
        "sadakat": {
          "type": "number"
        },
        "mizac": {
          "type": "number"
        },
        "durus": {
          "type": "number"
        },
        "dogruluk": {
          "type": "number"
        }
      }
    },
    "storyMeta": {
      "type": "object",
      "description": "Faz B anlati kimligi: defter imzasi ve arc/beat etiketleri.",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "arc": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$"
        },
        "beat": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$"
        },
        "slot": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$"
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9_:-]+$"
        }
      }
    },
    "repeatPolicy": {
      "type": "object",
      "description": "Olay bazli tekrar freni: arc/beat/imza araligi ve beat kullanim siniri.",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "arcGapTurns": {
          "type": "number",
          "minimum": 0
        },
        "beatGapTurns": {
          "type": "number",
          "minimum": 0
        },
        "signatureGapTurns": {
          "type": "number",
          "minimum": 0
        },
        "maxBeatUses": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "condition": {
      "description": "Ozyinelemeli kosul agaci: allOf / anyOf / noneOf / not ya da { flag, op, value }.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "allOf"
          ],
          "additionalProperties": false,
          "properties": {
            "allOf": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "anyOf"
          ],
          "additionalProperties": false,
          "properties": {
            "anyOf": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "noneOf"
          ],
          "additionalProperties": false,
          "properties": {
            "noneOf": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/definitions/condition"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "flag",
            "op"
          ],
          "additionalProperties": false,
          "properties": {
            "flag": {
              "type": "string"
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte",
                "in",
                "notIn",
                "isSet",
                "turnsSince",
                "between"
              ]
            },
            "value": {}
          }
        }
      ]
    },
    "effectValue": {
      "oneOf": [
        {
          "type": [
            "number",
            "boolean",
            "string"
          ]
        },
        {
          "type": "object",
          "description": "Kariyer seviyesine gore olceklenen deger; ciraga 100 bin, ikona 2 milyon.",
          "required": [
            "scaleBy",
            "base",
            "perTier"
          ],
          "additionalProperties": false,
          "properties": {
            "scaleBy": {
              "enum": [
                "stature",
                "clubTier",
                "season"
              ]
            },
            "base": {
              "type": "number"
            },
            "perTier": {
              "type": "number"
            },
            "clampMin": {
              "type": "number"
            },
            "clampMax": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "description": "Calisma zamaninda bir bayraktan okunan deger: flags[ref] * mul + add. 'Yatirdigin kadar kaybet' gibi miktari OYUNCUNUN belirledigi efektler icin.",
          "required": [
            "ref"
          ],
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string",
              "description": "Okunacak sayisal bayrak."
            },
            "mul": {
              "type": "number"
            },
            "add": {
              "type": "number"
            },
            "clampMin": {
              "type": "number"
            },
            "clampMax": {
              "type": "number"
            }
          }
        }
      ]
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "flag",
            "op"
          ],
          "additionalProperties": false,
          "properties": {
            "flag": {
              "type": "string"
            },
            "op": {
              "enum": [
                "set",
                "add",
                "mul",
                "unset"
              ]
            },
            "value": {
              "$ref": "#/definitions/effectValue"
            }
          }
        },
        {
          "type": "object",
          "description": "Zincirin halkasini takvime koyar. `forced` agirlikli secimi bypass eder.",
          "required": [
            "op",
            "event",
            "inTurns",
            "priority"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "schedule"
            },
            "event": {
              "type": "string"
            },
            "inTurns": {
              "type": "number",
              "minimum": 0
            },
            "priority": {
              "enum": [
                "forced",
                "weighted"
              ]
            },
            "onIneligible": {
              "enum": [
                "defer",
                "fire",
                "cancel"
              ]
            },
            "maxDeferTurns": {
              "type": "number",
              "minimum": 0
            },
            "replaceWith": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "lifeState"
            },
            "to": {
              "$ref": "#/definitions/lifeState"
            },
            "forTurns": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "clubTier"
            },
            "to": {
              "$ref": "#/definitions/clubTier"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "match"
            },
            "goals": {
              "type": "number"
            },
            "assists": {
              "type": "number"
            },
            "yellowCards": {
              "type": "number"
            },
            "injuryWeeks": {
              "type": "number"
            },
            "rating": {
              "type": "number"
            },
            "redCard": {
              "type": "boolean"
            },
            "incident": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "matches",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "suspend"
            },
            "matches": {
              "type": "number",
              "minimum": 0
            },
            "reason": {
              "type": "string"
            }
          }
        }
      ]
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/effect"
      }
    },
    "weightExpression": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "required": [
            "base"
          ],
          "additionalProperties": false,
          "properties": {
            "base": {
              "type": "number"
            },
            "modifiers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "flag",
                  "scale"
                ],
                "additionalProperties": false,
                "properties": {
                  "flag": {
                    "type": "string"
                  },
                  "scale": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "choice": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false,
      "dependencies": {
        "requires": {
          "required": [
            "lockLabel"
          ],
          "description": "Kosullu secim lockLabel ZORUNLU: oyuncu neyi kacirdigini gormeli."
        }
      },
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string"
        },
        "effects": {
          "$ref": "#/definitions/effects"
        },
        "requires": {
          "$ref": "#/definitions/condition"
        },
        "lockLabel": {
          "type": "string",
          "minLength": 1
        },
        "hideWhenLocked": {
          "type": "boolean"
        },
        "persona": {
          "$ref": "#/definitions/persona"
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "title",
        "text",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "branch",
            "outcome",
            "roll"
          ]
        },
        "format": {
          "enum": [
            "text",
            "sms",
            "voice",
            "news",
            "tweet",
            "mail",
            "chat"
          ]
        },
        "onEnter": {
          "$ref": "#/definitions/effects"
        },
        "next": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/choice"
          }
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "target",
              "weight"
            ],
            "additionalProperties": false,
            "properties": {
              "target": {
                "type": "string"
              },
              "weight": {
                "$ref": "#/definitions/weightExpression"
              },
              "effects": {
                "$ref": "#/definitions/effects"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "branch"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "choices"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "roll"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "outcomes"
            ]
          }
        }
      ]
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/node"
      }
    }
  }
}
