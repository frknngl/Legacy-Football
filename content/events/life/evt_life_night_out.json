    {
      "id": "v_terk_edilis",
      "rootNode": "n_root",
      "nodes": {
        "n_root": {
          "title": "Gece Kulübü VIP: Night Out",
          "kind": "branch",
          "text": "Antrenman tesisinin otoparkında, yağmur şiddetle ön cama vuruyor. {actor.childhood_friend.name} ile geçen hafta bu zamanlar bir restoranda buluşmak için sözleşmiştiniz. Mekan kapandı, ışıklar söndü. Telefonunda tek bir mesaj yok. Yıllar önce seninle aynı ayakkabıları paylaşan kişi, şimdi bir siluet kadar uzak. Elinde tuttuğun iki kişilik davetiye, torpido gözünün üzerinde, ıslanmış bir kağıt parçasına dönüşüyor. İhanet, sesli bir patlama değil; sessiz bir bekleme anı.",
          "choices": [
            {
              "id": "c_riskli",
