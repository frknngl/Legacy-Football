                {
                  "flag": "moral",
                  "op": "add",
                  "value": -12
                },
                {
                  "flag": "mental_dayaniklilik",
                  "op": "add",
                  "value": -4
                }
              ],
              "persona": {
                "sadakat": 7
              }
            },
            {
              "id": "c_acikla",
              "text": "\"Talimat oydu.\" Nerede durduğunu anlat.",
