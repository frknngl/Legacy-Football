        "n_ustlen": {
          "title": "Benim Hatam",
          "kind": "outcome",
          "text": "\"Benim hatam.\"\n\n{actor.manager.name} bir şey daha söyleyecekti, söylemedi. Tahtayı aldı, ikinci yarıyı anlattı.\n\nOdadan çıkarken {actor.captain.name} omzuna vurdu. Tek kelime etmedi.\n\nİkinci yarıda bir gol attınız, yetmedi. Ama o odada bir şey kazanmıştın ve skor tablosunda görünmüyordu.",
          "onEnter": [
            {
              "flag": "mem_devre_arasi_ustlendi",
              "op": "set",
              "value": true
            }
          ]
        },
        "n_acikla": {
          "title": "Talimat Oydu",
          "kind": "outcome",
          "text": "\"Talimat oydu,\" dedin ve nerede durduğunu anlattın. Doğruydu. Odadaki herkes doğru olduğunu biliyordu.\n\n{actor.manager.name} sana on saniye baktı. \"Tamam,\" dedi.\n\nİkinci yarıda oynadın. Sonraki maçta da oynadın.\n\nAma o \"tamam\" hiç bitmedi. Üç ay sonra kadro dışı kaldığında, o odayı hatırladın ve haklı olmanın nereye yazıldığını merak ettin.",
          "onEnter": [
            {
              "flag": "mem_devre_arasi_savundu",
