      "nodes": {
        "n_root": {
          "title": "On Beş Dakika",
          "kind": "branch",
          "text": "Devre arası. Skor aleyhinize ve ikinci gol senin arkandan geldi.\n\nSoyunma odası sessiz. {actor.manager.name} tahtayı almıyor bile — parmağını kaldırıp seni gösteriyor.\n\n\"Sen. Sen nerede duruyordun?\"\n\nNerede durduğunu biliyorsun. Talimatta durman gereken yerde duruyordun ve tam da bu yüzden gol oldu.\n\n{actor.captain.name} yere bakıyor. Kimse konuşmuyor. Saat işliyor: on bir dakika kaldı.",
          "choices": [
            {
              "id": "c_ustlen",
              "text": "\"Benim hatam.\" Kısa kes, ikinci yarıya bak.",
              "target": "n_ustlen",
              "effects": [
                {
                  "flag": "iliski_manager",
                  "op": "add",
                  "value": 9
                },
                {
                  "flag": "iliski_takim",
                  "op": "add",
