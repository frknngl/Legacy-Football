              "value": true
            },
            {
              "flag": "mem_hocaya_karsi_geldi",
              "op": "set",
              "value": true
            }
          ]
        },
        "n_sus": {
          "title": "Krampon Bağı",
          "kind": "outcome",
          "text": "Eğildin, kramponunu çözdün, yeniden bağladın. İki kez.\n\n{actor.manager.name} bir süre bekledi, sonra tahtaya döndü.\n\nSustuğun için ne ceza aldın ne ödül. Sadece o gün, odadaki herkes senin ne tür biri olduğuna dair küçük bir not aldı — ve o notlar birikiyor.",
          "onEnter": [
