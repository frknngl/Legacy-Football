      "nodes": {
        "n_root": {
          "title": "Kritik Eşik",
          "kind": "branch",
          "text": "Antrenman sahasının tozlu koridorunda, {actor.doctor.name} elindeki tabletle bir köşe başını tutmuş bekliyor. Pencereden vuran öğle güneşi, odadaki toz zerrelerini belirginleştiriyor. Ses yok; sadece dışarıdaki çim biçme makinesinin boğuk motor sesi. {actor.doctor.name}, ekrandaki veriyi durdurup sana doğru bir adım atıyor. Bakışları, dizindeki eski sargının üzerine kilitlenmiş durumda. Ortada ne bir tıbbi cihaz ne de bir dosya var; sadece ikiniz ve yaklaşan sonun ağırlığı.",
          "choices": [
            {
              "id": "c_gri",
